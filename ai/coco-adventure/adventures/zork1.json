 "events": [
  {
   "if": [
    "in:living_room",
    "flag:trap_closing"
   ],
   "do": [
    {
     "unset": "trap_closing"
    }
   ]
  },
  {
   "if": [
    "in:cellar",
    "!flag:trap_used"
   ],
   "do": [
    "The trap door crashes shut, and you hear someone barring it.",
    {
     "set": [
      "trap_used",
      "trap_barred"
     ]
    },
    {
     "prop": "trap_door",
     "key": "open",
     "value": false
    }
   ]
  },
  {
   "if": [
    "in:troll_room",
    "!flag:troll_dead"
   ],
   "do": [
    {
     "if": "var:troll_attacks>=0",
     "then": [
      {
       "var": "troll_attacks",
       "add": 1
      }
     ]
    },
    {
     "if": "var:troll_attacks>=2",
     "then": [
      {
       "random": [
        [
         "The troll swings his axe, but it misses."
        ],
        [
         "The axe sweeps past as you jump aside."
        ],
        [
         "The troll's axe barely misses your ear."
        ],
        [
         {
          "var": "wounds",
          "add": 1
         },
         "The axe gets you right in the side. Ouch!"
        ],
        [
         {
          "var": "wounds",
          "add": 1
         },
         "The flat of the troll's axe hits you delicately on the head, knocking you briefly senseless."
        ]
       ]
      },
      {
       "if": "var:wounds>=3",
       "then": [
        {
         "die": "The troll's mighty blow drops you to your knees.\nThe troll lands a deadly blow. It appears that that last blow was too much for you. I'm afraid you are dead."
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "if": "!in:troll_room",
   "do": [
    {
     "var": "troll_attacks",
     "value": 0
    }
   ]
  },
  {
   "if": "dark",
   "do": [
    {
     "var": "darkturns",
     "add": 1
    },
    {
     "if": [
      "var:darkturns>=2",
      "chance:60"
     ],
     "then": [
      {
       "die": "Oh, no! You have walked into the slavering fangs of a lurking grue!"
      }
     ]
    }
   ]
  },
  {
   "if": "!dark",
   "do": [
    {
     "var": "darkturns",
     "value": 0
    }
   ]
  },
  {
   "if": [
    "at:egg:trophy_case",
    "at:painting:trophy_case",
    "at:coins:trophy_case"
   ],
   "once": true,
   "do": [
    {
     "win": "An almost inaudible voice whispers in your ear, \"Look to your treasures for the final secret.\"\n\nYou have gathered every treasure in this excerpt of the Great Underground Empire. The full ZORK I - with the thief, the dam, the Land of the Dead and nineteen treasures in all - is free to play and study under the MIT License."
    }
   ]
  }
 ]
