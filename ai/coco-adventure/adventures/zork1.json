 "actions": [
  {
   "verb": "attack",
   "noun": "troll",
   "if": "flag:troll_dead",
   "do": "There's no troll left to attack."
  },
  {
   "verb": "attack",
   "noun": "troll",
   "if": {
    "any": [
     "has:sword",
     "has:knife",
     "has:rusty_knife",
     "has:axe"
    ]
   },
   "do": [
    {
     "if": "has:sword",
     "then": [
      {
       "var": "hitroll",
       "value": 0
      },
      {
       "random": [
        [
         {
          "var": "hitroll",
          "value": 1
         }
        ],
        [
         {
          "var": "hitroll",
          "value": 1
         }
        ],
        [
         {
          "var": "hitroll",
          "value": 0
         }
        ]
       ]
      }
     ],
     "else": [
      {
       "var": "hitroll",
       "value": 0
      },
      {
       "random": [
        [
         {
          "var": "hitroll",
          "value": 1
         }
        ],
        [
         {
          "var": "hitroll",
          "value": 0
         }
        ],
        [
         {
          "var": "hitroll",
          "value": 0
         }
        ]
       ]
      }
     ]
    },
    {
     "if": "var:hitroll==1",
     "then": [
      {
       "var": "troll_hp",
       "add": 1
      },
      {
       "if": "var:troll_hp>=2",
       "then": [
        "The fatal blow strikes the troll square in the heart: He dies.\nAlmost as soon as the troll breathes his last breath, a cloud of sinister black fog envelops him, and when the fog lifts, the carcass has disappeared.",
        {
         "set": "troll_dead",
         "destroy": "troll"
        },
        {
         "move": "axe",
         "to": "here"
        }
       ],
       "else": [
        {
         "random": [
          "The troll is staggered, and drops to his knees.",
          "A good slash, and it draws first blood!",
          "The troll is battered into near unconsciousness - but struggles back to his feet."
         ]
        }
       ]
      }
     ],
     "else": [
      {
       "random": [
        "A good slash, but it misses the troll by a mile.",
        "You charge, but the troll jumps nimbly aside.",
        "The troll parries your blow with his axe.",
        "Clang! Your blow bounces off the troll's axe."
       ]
      }
     ]
    }
   ],
   "else": "Attacking the troll with your bare hands is suicidal."
  },
  {
   "verb": "take",
   "noun": "water",
   "if": "at:water:bottle",
